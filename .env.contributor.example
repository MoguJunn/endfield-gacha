# ============================================
# 终末地抽卡分析器 - 外部贡献者安全环境变量模板
# ============================================
# 用途:
# - 给外部贡献者本地运行前端、查看完整演示页面，并可选择调用公开读取链路。
# - 只包含浏览器端本来就会公开的 VITE_* 变量。
#
# 使用方法:
# 1. 复制为 .env.local
# 2. npm install
# 3. npm run dev
# 4. 默认启用本地内容沙盒，并通过正式站公共 GET 接口读取真实游戏目录；不需要数据库 key。
#
# 安全边界:
# - 不要在这个文件里填写 SUPABASE_SECRET_KEY、SUPABASE_SERVICE_ROLE_KEY、SUPABASE_JWT_SECRET。
# - 不要填写 SMTP 密码、OAuth Client Secret、BOT token、Cron secret、CAPTCHA secret。
# - 如果你需要调试后台、邮件、运营自动化或私有写入任务，请使用本地 Supabase 或联系维护者开临时最小权限环境。

# ====== 本地站点 ======
VITE_APP_URL=http://127.0.0.1:5173
# 如果通过 nginx / 内网 IP / 临时域名反代访问 Vite，请改成浏览器实际访问的 origin，
# 例如 http://172.105.101.164:5173 或 https://dev.example.com，并重启 npm run dev。

# ====== 贡献者本地内容沙盒 ======
# 仅在 Vite DEV 中生效；生产构建即使误配也会强制关闭。
# 开启后从正式站公共 GET 接口读取真实卡池、角色、武器和阵容；最后一次成功目录会保存在浏览器。
# 公告、卡池、角色、版本和站点配置可在 localStorage 沙盒中修改、刷新保留或一键重置。
# 私有同源 API、Supabase 读取 / RPC / 写入、Realtime、邮件、开奖、密钥和自动化执行仍被阻断。
VITE_CONTRIBUTOR_DEMO_MODE=true
# 可替换为维护者提供的只读公共目录镜像；镜像主机还必须加入下一项白名单。
VITE_CONTRIBUTOR_CATALOG_API_BASE=https://ef-gacha.mogujun.icu
VITE_CONTRIBUTOR_CATALOG_ALLOWED_HOSTS=
# 公告 Markdown、卡池 banner 和实体头像默认只加载同源安全路径与正式站资源。
# 如需测试额外 CDN，请只填写可信 HTTPS 主机名，以逗号分隔，不能填写 URL、IP 或私网主机。
VITE_PUBLIC_RESOURCE_ALLOWED_HOSTS=
# 登录页会显示并可自动填入以下公开本地演示账号：
# demo-admin@local.invalid / frontend-demo
# 该账号不是数据库账号，没有真实 token；它只能修改当前浏览器的本地内容沙盒。

# ====== 公开 Supabase 读取配置 ======
# 这是站点自建数据库的公开 API 域名。只能配合 publishable/anon key 和 RLS 访问公开或本人授权的数据。
VITE_SUPABASE_URL=https://db.15963574.xyz
# 如果只按 Supabase Dashboard 命名填写，也可用 SUPABASE_URL；该 URL 会暴露到浏览器。
# SUPABASE_URL=https://db.15963574.xyz

# 只在关闭贡献者演示模式、需要调试真实公开读取时向维护者索取。
# 该 key 允许出现在浏览器中，但必须是受 RLS 限制的低权限公开 key。
VITE_SUPABASE_PUBLISHABLE_KEY=
# 兼容 Supabase Dashboard 短变量名；不要填 secret/service_role。
# PUBLISHABLE_KEY=
# 旧版兼容别名；一般不用填。
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# 只配置公开 key 时，后台、邮件、OAuth 桥接、站点 HttpOnly session、运营自动化等
# 高权限服务端功能仍会返回 503；工单、账号资料、最后在线和抽卡数据等用户级接口
# 会在携带当前用户 Bearer token 时回退到 publishable key + RLS 路径。

# 生产首屏默认走同源 /api。贡献者本地不要默认启用浏览器直连 Supabase 的公共数据回退。
VITE_PUBLIC_DATA_DIRECT_SUPABASE_FALLBACK=false

# 关闭 Realtime，避免外部贡献者本地因为网络或权限看到 WebSocket 超时。
VITE_SUPABASE_REALTIME_ENABLED=false

# ====== 私有导入代理 ======
# 官方导入代理不随公开仓库提供。留空时，只能测试不依赖私有代理的公开页面和 UI。
VITE_PROXY_URL_CN=
VITE_PROXY_URL_INTL=

# ====== 验证码前端开关 ======
# 默认关闭。需要测试验证码 UI 时，贡献者应使用自己的 Turnstile / hCaptcha site key。
VITE_AUTH_CAPTCHA_MODE=off
VITE_AUTH_CAPTCHA_PROVIDER=turnstile
VITE_AUTH_CAPTCHA_REQUIRED_ACTIONS=register,password_reset,account_recovery
VITE_AUTH_CAPTCHA_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_HCAPTCHA_SITE_KEY=

# ====== 第三方登录按钮 ======
# 默认关闭。GitHub / Linux.do / QQ 的真实 Client Secret 只放服务端环境变量，不进入 VITE_*。
# GitHub Phase A–D 候选和隔离环境中的登录/绑定/解绑/重绑核心浏览器闭环已完成；贡献者环境
# 仍继续关闭。LinuxDo 暂缓重新实现，QQ 等待平台条件。这些变量只控制按钮，不启用服务端 provider。
VITE_AUTH_OAUTH_GITHUB_ENABLED=false
VITE_AUTH_OAUTH_LINUXDO_ENABLED=false
VITE_AUTH_OAUTH_QQ_ENABLED=false

# ====== 可选公开入口 ======
VITE_PUZZLE_PLAYER_URL=

# 本地开发缓存标记。需要强制浏览器刷新缓存时可手动改一个新值。
VITE_APP_FORCE_REFRESH_TOKEN=local-contributor
