[Unit]
Description=Endfield scheduled statistics worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=endfield
WorkingDirectory=/opt/endfield-gacha
EnvironmentFile=/etc/endfield/statistics.env
ExecStart=/usr/bin/node --max-old-space-size=1536 scripts/run-statistics-worker.mjs
TimeoutStartSec=8min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
