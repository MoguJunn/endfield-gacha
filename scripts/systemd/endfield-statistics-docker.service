[Unit]
Description=Endfield scheduled statistics worker (isolated Node runtime)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Install as endfield-statistics.service. Bundle the worker into
# /opt/endfield-statistics/worker.mjs; keep statistics.env root-readable only.
# Max jobs limits overhead for many small personal snapshots; the worker also
# stops claiming after its 240-second budget. Tasks remain serial.
ExecStart=/usr/bin/docker run --rm --name endfield-statistics-worker --network host --memory=1200m --memory-swap=1200m --cpus=1 --read-only --cap-drop=ALL --security-opt=no-new-privileges --user 65534:65534 --env-file /etc/endfield/statistics.env -e STATISTICS_MAX_JOBS=500 -v /opt/endfield-statistics:/app:ro node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 node --max-old-space-size=768 /app/worker.mjs
ExecStopPost=-/usr/bin/docker stop -t 30 endfield-statistics-worker
TimeoutStartSec=8min
TimeoutStopSec=45s
