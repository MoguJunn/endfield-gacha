[Unit]
Description=Backfill Endfield personal luck v1
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# One-time supplement using the same lock and capped runtime as other workers.
TimeoutStartSec=30min
ExecStart=/usr/bin/flock -w 470 /run/lock/endfield-analysis-workers.lock /usr/bin/docker run --rm --name endfield-personal-luck-backfill --network host --memory=768m --memory-swap=768m --cpus=1 --read-only --cap-drop=ALL --security-opt=no-new-privileges --user 65534:65534 --env-file /etc/endfield/statistics.env -e SUPABASE_URL=http://127.0.0.1:8010 -v /opt/endfield-statistics:/app:ro node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 node --max-old-space-size=512 /app/personal-luck-backfill.mjs
NoNewPrivileges=true
